<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_navigation_graph"
    app:startDestination="@id/mediatekaFragment">

    <fragment
        android:id="@+id/tracksFragment"
        android:name="com.michael.playlistmaker.ui.search.TracksFragment"
        android:label="fragment_search"
        tools:layout="@layout/fragment_search" />
    <fragment
        android:id="@+id/mediatekaFragment"
        android:name="com.michael.playlistmaker.ui.mediateka.MediatekaFragment"
        android:label="fragment_mediateka"
        tools:layout="@layout/fragment_mediateka" >
        <action
            android:id="@+id/action_mediatekaFragment_to_fragmentMakeNewPlaylist"
            app:destination="@id/fragmentMakeNewPlaylist" />
        <action
            android:id="@+id/action_mediatekaFragment_to_fragmentPlaylistInside"
            app:destination="@id/fragmentPlaylistInside" />
    </fragment>
    <fragment
        android:id="@+id/settingFragment"
        android:name="com.michael.playlistmaker.ui.settings.SettingFragment"
        android:label="fragment_settings"
        tools:layout="@layout/fragment_settings" />
    <fragment
        android:id="@+id/fragmentMakeNewPlaylist"
        android:name="com.michael.playlistmaker.ui.audioplayer.FragmentMakeNewPlaylist"
        android:label="FragmentMakeNewPlaylist" />
    <fragment
        android:id="@+id/fragmentPlaylistInside"
        android:name="com.michael.playlistmaker.ui.mediateka.FragmentPlaylistInside"
        android:label="FragmentPlaylistInside" />
</navigation>